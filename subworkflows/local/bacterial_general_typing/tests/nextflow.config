includeConfig '../../../../conf/modules.config'

params {
    pipeline_root = "${projectDir}/../../../.."
    outdir = "${projectDir}/out"
    publish_dir_mode = 'copy'
    virulencefinder_db = "${params.pipeline_root}/test_data/general_typing/virulencefinder"
    virulencefinder_min_coverage = 0.6
    virulencefinder_min_identity = 0.9
    bacterial_blast_reference = "${params.pipeline_root}/test_data/general_typing/blast_reference.fa"
    bacterial_blast_db = null
    bacterial_blast_db_label = 'unit_test_reference'
    bacterial_blast_min_identity = 90
    bacterial_blast_min_coverage = 80
    bacterial_blast_overlap_bp = 1
}

process.executor = 'local'

conda.enabled = false
docker.enabled = false
podman.enabled = false
singularity.enabled = false
apptainer.enabled = false
