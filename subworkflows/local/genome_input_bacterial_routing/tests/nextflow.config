params {
    test_data_dir = "${projectDir}/data"
    pipeline_root = "${projectDir}/../../../.."
    outdir = "${projectDir}/out"
    publish_dir_mode = 'copy'
    genome_input = null
    sourmash_database = null
    sourmash_taxonomy_csv = null
}

process {
    executor = 'local'
}

conda.enabled = false
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
