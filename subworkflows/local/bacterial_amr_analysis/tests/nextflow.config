includeConfig '../../../../conf/modules.config'

params {
    pipeline_root = "${projectDir}/../../../.."
    outdir = "${projectDir}/out"
    publish_dir_mode = 'copy'

    amrfinderplus_db = "${params.pipeline_root}/test_data/amr_databases/amrfinder"
    abricate_db = "${params.pipeline_root}/test_data/amr_databases/abricate"
    abricate_db_id = 'ncbi'
    abricate_db_version = '2021-Mar-27'
    rgi_preparecarddb_dir = "${params.pipeline_root}/test_data/amr_databases/rgi"
    rgi_include_wildcard = true
    resfinder_db = "${params.pipeline_root}/test_data/amr_databases/resfinder"
    pointfinder_db = "${params.pipeline_root}/test_data/amr_databases/pointfinder"
    deeparg_db = "${params.pipeline_root}/test_data/amr_databases/deeparg"
    deeparg_db_version = '1'
    annotation_pyrodigal_transtable = 11
}

process {
    executor = 'local'
}

env {
    PATH = "${projectDir}/bin:${System.getenv('PATH')}"
}

conda.enabled = false
docker.enabled = false
podman.enabled = false
singularity.enabled = false
apptainer.enabled = false
