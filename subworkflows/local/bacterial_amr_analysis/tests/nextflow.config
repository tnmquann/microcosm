// Pipeline defaults (params incl. bacterial downstream switches) + process selectors.
includeConfig '../../../../conf/base.config'
includeConfig '../../../../conf/modules.config'

params {
    pipeline_root = "${projectDir}/../../../.."
    outdir = "${projectDir}/out"
    publish_dir_mode = 'copy'
    trace_report_suffix = 'subworkflow_test'
    genomes_dir = null
}

process.executor = 'local'
trace.enabled = false
