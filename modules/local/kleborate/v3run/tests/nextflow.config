params.genomes_dir = '/scratch/quantnm/.nextflow-workcache/microcosm_development/genomes'
process {
    executor = 'local'
    withName: KLEBORATE_V3_RUN { ext.prefix = { "${meta.genome_id}.kleborate" }; cpus = 2 }
}
singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/quantnm/.nextflow-workcache/singularity'
}
