// ============================================================================
// MODULE CONFIGURATIONS
// ============================================================================

process {

    // ========================================================================
    // QC & PREPROCESSING
    // ========================================================================

    withName: 'FASTQC_RAW' {
        publishDir = [
            [
                path: { "${params.outdir}/Preprocess/QC/Raw_reads/${meta.id}" },
                mode: 'copy',
                pattern: "*_fastqc.{html,zip}"
            ],
            [
                path: { "${params.outdir}/Preprocess/QC/Raw_reads" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'FASTP' {
        publishDir = [
            [
                path: { "${params.outdir}/Preprocess/Trimming/${meta.id}" },
                mode: 'copy',
                pattern: "*.fastq.gz"
            ],
            [
                path: { "${params.outdir}/Preprocess/Trimming/${meta.id}/report" },
                mode: 'copy',
                pattern: "*.{json,html}"
            ],
            [
                path: { "${params.outdir}/Preprocess/Trimming" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'FASTQC_TRIMMED' {
        publishDir = [
            [
                path: { "${params.outdir}/Preprocess/QC/Trimming/${meta.id}" },
                mode: 'copy',
                pattern: "*_fastqc.{html,zip}"
            ],
            [
                path: { "${params.outdir}/Preprocess/QC/Trimming" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'HOSTILE_CLEAN' {
        publishDir = [
            [
                path: { "${params.outdir}/Preprocess/Remove_HostGenome/${meta.id}" },
                mode: 'copy',
                pattern: "*.fastq.gz",
                saveAs: { filename -> "cleaned_reads/${filename.tokenize('/').last()}" }
            ],
            [
                path: { "${params.outdir}/Preprocess/Remove_HostGenome/${meta.id}" },
                mode: 'copy',
                pattern: "cleaned_reads/*.fastq.gz",
                saveAs: { filename -> "cleaned_reads/${filename.tokenize('/').last()}" }
            ],
            [
                path: { "${params.outdir}/Preprocess/Remove_HostGenome/${meta.id}/report" },
                mode: 'copy',
                pattern: "*.json"
            ],
            [
                path: { "${params.outdir}/Preprocess/Remove_HostGenome" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'HOSTILE_FETCH' {
        publishDir = [
                path: { "${params.outdir}/Databases/hostile/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename }
        ]
    }

    withName: 'FASTQC_RMHOST' {
        publishDir = [
            [
                path: { "${params.outdir}/Preprocess/QC/Remove_HostGenome/${meta.id}" },
                mode: 'copy',
                pattern: "*_fastqc.{html,zip}"
            ],
            [
                path: { "${params.outdir}/Preprocess/QC/Remove_HostGenome/" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'MERGE_PAIREDENDSEQS' {
        publishDir = [
            path: { "${params.outdir}/Preprocess/Merged_sequences" },
            mode: params.publish_dir_mode,
            enabled: params.enable_copymergedseqs
        ]
    }

    // ========================================================================
    // READ-BASED PROFILING
    // ========================================================================

    withName: 'CREATE_READS_CSV' {
        ext.args = ""
        ext.prefix = "batch"
        tag = { "batch_reads" }
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/reads_collected" },
            mode: params.publish_dir_mode,
            pattern: "*.csv"
        ]
    }

    withName: 'SOURMASH_MANYSKETCH_META' {
        ext.args_sourmash = ""
        ext.prefix = "batch"
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/sketches" },
            mode: params.publish_dir_mode,
            enabled: params.enable_copysketch
        ]
    }

    withName: 'EXTRACT_SOURMASH_SINGLESKETCHES_META' {
        ext.args_python = ""
        ext.prefix = "batch"
        publishDir = [
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/sketches/single_sketches" },
                mode: params.publish_dir_mode,
                enabled: params.enable_copysketch_singles
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/sketches" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'SOURMASH_FASTMULTIGATHER_META' {
        ext.args = [
            params.sourmash_thresholdbp ? "--threshold-bp=${params.sourmash_thresholdbp}" : '--threshold-bp=50000'
        ].join(' ').trim()
        ext.prefix = "sourmash_reads"
        publishDir = [
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT" },
                mode: params.publish_dir_mode,
                pattern: "fastmultigather/*_sourmash_gather.csv"
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/fastmultigather" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'SOURMASH_TAXANNOTATE_META' {
        ext.args = ""
        ext.prefix = "batch_sourmash_gather"
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/taxannotate" },
            mode: params.publish_dir_mode,
            pattern: "*.with-lineages.csv.gz"
        ]
    }

    withName: 'SOURMASH_TAXMETAGENOME_SINGLESKETCH' {
        ext.args = "--output-format ${params.sourmash_output_format}"
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT" },
            mode: params.publish_dir_mode,
            pattern: "taxmetagenome/*.csv"
        ]
    }

    withName: 'SOURMASH_TAXMETAGENOME' {
        ext.args = "--output-format ${params.sourmash_output_format}"
        ext.prefix = "batch"
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT" },
            mode: params.publish_dir_mode,
            pattern: "taxmetagenome/*.csv"
        ]
    }

    withName: 'YACHT_RUN' {
        publishDir = [
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT" },
                mode: params.publish_dir_mode,
                pattern: "yacht_results/*.xlsx"
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/yacht_results/version" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'PROCESS_READBASED_RESULTS' {
        publishDir = [
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/final_results" },
                mode: params.publish_dir_mode,
                pattern: "final_results"
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/final_results/version" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/yacht_results" },
                mode: params.publish_dir_mode,
                pattern: "temp_yacht_results"
            ]
        ]
    }

    // ========================================================================
    // READ-BASED PROFILING - SINGLE SAMPLE MODE (enable_singlesketch=true)
    // ========================================================================

    withName: 'SOURMASH_SKETCH_META' {
        ext.args = [
            params.sourmash_profile ? "-p ${params.sourmash_profile}" : "dna --param-string 'scaled=1000,k=21,k=31,k=51,abund'",
            "-k ${params.sourmash_ksize ?: 31}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/sketches" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SOURMASH_SIG_TO_ZIP' {
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/sketches" },
            mode: params.publish_dir_mode,
            enabled: params.enable_copysketch,
            pattern: "*.sig.zip"
        ]
    }

    withName: 'SOURMASH_GATHER_META' {
        ext.args = [
            params.sourmash_thresholdbp ? "--threshold-bp ${params.sourmash_thresholdbp}" : '--threshold-bp 50000',
            "-k ${params.sourmash_ksize ?: 31}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/gather" },
            mode: params.publish_dir_mode,
            pattern: "*.csv.gz"
        ]
    }

    withName: 'YACHT_RUN_SINGLESKETCH' {
        publishDir = [
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/" },
                mode: params.publish_dir_mode,
                pattern: "yacht_results/*.xlsx"
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/yacht_results" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'PROCESS_READBASED_RESULTS_SINGLESKETCH' {
        ext.prefix = { "${meta.id}" }
        ext.min_coverage = 0.05
        ext.py_args = '--remove_unclassified'
        publishDir = [
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/final_results" },
                mode: 'copy',
                pattern: "*_processedresult"
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Sourmash-YACHT/final_results" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    withName: 'POSTPROCESS_READBASED' {
        publishDir = [
            [
                path: { single_sample_layout ? "${params.outdir}/Readbased_Analysis/Post_processing/${output_prefix}" : "${params.outdir}/Readbased_Analysis/Post_processing" },
                mode: params.publish_dir_mode,
                pattern: "*_default",
                saveAs: { filename -> single_sample_layout ? 'default' : filename }
            ],
            [
                path: { single_sample_layout ? "${params.outdir}/Readbased_Analysis/Post_processing/${output_prefix}" : "${params.outdir}/Readbased_Analysis/Post_processing" },
                mode: params.publish_dir_mode,
                pattern: "*_phyloseq",
                saveAs: { filename -> single_sample_layout ? 'phyloseq' : filename }
            ],
            [
                path: { single_sample_layout ? "${params.outdir}/Readbased_Analysis/Post_processing/${output_prefix}" : "${params.outdir}/Readbased_Analysis/Post_processing" },
                mode: params.publish_dir_mode,
                pattern: "*_taxburst",
                saveAs: { filename -> single_sample_layout ? 'taxburst' : filename }
            ],
            [
                path: { single_sample_layout ? "${params.outdir}/Readbased_Analysis/Post_processing/${output_prefix}" : "${params.outdir}/Readbased_Analysis/Post_processing" },
                mode: params.publish_dir_mode,
                pattern: "*_rgi_bwt",
                saveAs: { filename -> single_sample_layout ? 'rgi_bwt' : filename }
            ],
            [
                path: { "${params.outdir}/Readbased_Analysis/Post_processing/versions/${output_prefix}" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }

    // ========================================================================
    // READ-BASED AMR DETECTION (RGI-BWT)
    // ========================================================================

    withName: 'RGI_PREPARECARDDB' {
        publishDir = [
            path: { "${params.outdir}/Databases/RGI/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }

    withName: 'RGI_BWT' {
        ext.args   = [
            params.rgi_include_wildcard ? "--include_wildcard" : "",
            params.rgi_include_other_models ? "--include_other_models" : "",
            params.rgi_bwt_args,
            "-a ${params.rgi_aligner ?: 'kma'}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/Readbased_Analysis/rgi_bwt" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }

    // ========================================================================
    // ASSEMBLY
    // ========================================================================

    withName: 'MEGAHIT' {
        ext.args   = { params.megahit_options ? params.megahit_options + " -m ${task.memory.toBytes()}" : "-m ${task.memory.toBytes()}" }
        ext.prefix = { "MEGAHIT-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Assembly/MEGAHIT" },
            mode: params.publish_dir_mode,
            pattern: "*.{fa.gz,log}"
        ]
    }

    withName: 'METASPADES' {
        ext.args   = { params.spades_options ? "${params.spades_options} --meta" : '--meta' }
        ext.prefix = { "SPAdes-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Assembly/SPAdes" },
            mode: params.publish_dir_mode,
            pattern: "*.{fasta.gz,gfa.gz,fa.gz,log}"
        ]
    }

    withName: 'METAQUAST' {
        publishDir = [
            path: { "${params.outdir}/Assembly/${meta.assembler}/QC/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // CONTIG ANALYSIS
    // ========================================================================

    withName: BWAMEM2_INDEX_CONTIGS {
        ext.prefix = { "${meta.assembler}-${meta.id}.bwamem2_idx" }
        publishDir = [
            path: { "${params.outdir}/ContigsAnalysis/bwamem2_index/" },
            pattern: "bwamem2/*",
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: BWAMEM2_MEM_CONTIGS {
        ext.prefix = { "${meta.assembler}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/ContigsAnalysis/mapped_reads/" },
            pattern: "*.{bam,yml}",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }

    withName: 'SEQKIT_FX2TAB' {
        ext.prefix = { "${meta.assembler}-${meta.id}.seqkit" }
        ext.args = "-ngli -H -C N"
        publishDir = [
            path: { "${params.outdir}/ContigsAnalysis/contig_stats/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename}
        ]
    }

    withName: 'SAMTOOLS_COVERAGE' {
        ext.prefix = { "${meta.assembler}-${meta.id}.coverage" }
        publishDir = [
            path: { "${params.outdir}/ContigsAnalysis/coverage/" }, 
            pattern: "*.{txt,yml}", 
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename}
        ]
    }

    withName: 'GENOMAD_DOWNLOAD' {
        publishDir = [
            path: { "${params.outdir}/Databases/genomad/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> params.save_genomad_db ? filename : null }
        ]
    }

    withName: 'GENOMAD_ENDTOEND' {
        ext.prefix = { "${meta.assembler}-${meta.id}.geNomad" }
        ext.args = [
            "--cleanup",
            "--min-score ${params.genomad_min_score}",
            "--splits ${params.genomad_splits}",
            "${params.genomad_e2e_options}"
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.outdir}/ContigsAnalysis/genomad/" },
                pattern: "*/*",
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename }
            ],
            [
                path: { "${params.outdir}/ContigsAnalysis/genomad/" },
                pattern: "versions.yml",
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename }
            ]
        ]
    }

    withName: 'SKANI_SEARCH' {
        ext.prefix = { "${meta.assembler}-${meta.id}.skani" }
        ext.args = params.skani_search_options ? "${params.skani_search_options} --qi" : '--qi'
        publishDir = [
            path: { "${params.outdir}/ContigsAnalysis/skani/" },
            pattern: "*.{tsv,yml}",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename}
        ]
    }

    withName: TIARA_TIARA {
        ext.prefix = { "${meta.assembler}-${meta.id}.tiara" }
        ext.args = "--min_len ${params.tiara_min_length} --probabilities"
        publishDir = [
            path: { "${params.outdir}/Taxonomy/Tiara/" },
            mode: params.publish_dir_mode,
            pattern: "*.txt"
        ]
    }

    // ========================================================================
    // CONTIG ANNOTATION
    // ========================================================================

    withName: 'PYRODIGAL' {
        ext.prefix = { "${meta.assembler}-${meta.id}.pyrodigal" }
        ext.args   = [
            params.annotation_pyrodigal_singlemode ? "-p single" : "-p meta",
            params.annotation_pyrodigal_closed ? "-c" : "",
            params.annotation_pyrodigal_forcenonsd ? "-n" : "",
            params.annotation_pyrodigal_usespecialstopcharacter ? '' : '--no-stop-codon',
            "-g ${params.annotation_pyrodigal_transtable}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/ContigsAnalysis/annotation/pyrodigal/" },
            mode: params.publish_dir_mode,
            enabled: params.save_contig_annotations,
            pattern: "*.{faa,fna,gbk,score}.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PROKKA' {
        ext.prefix = { "${meta.assembler}-${meta.id}.prokka" }
        ext.args   = [
            "--kingdom ${params.annotation_prokka_kingdom}",
            "--gcode ${params.annotation_prokka_gcode}",
            "--mincontiglen ${params.annotation_prokka_mincontiglen}",
            "--evalue ${params.annotation_prokka_evalue}",
            "--coverage ${params.annotation_prokka_coverage}",
            params.annotation_prokka_retaincontigheaders ? "--force" : "--locustag PROKKA --centre CENTER",
            params.annotation_prokka_singlemode ? '' : '--metagenome',
            params.annotation_prokka_cdsrnaolap ? '--cdsrnaolap' : '',
            params.annotation_prokka_rawproduct ? '--rawproduct' : '',
            params.annotation_prokka_rnammer ? '--rnammer' : '',
            params.annotation_prokka_compliant ? '--compliant' : '',
            params.annotation_prokka_addgenes ? '--addgenes' : ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/ContigsAnalysis/annotation/prokka/" },
            mode: params.publish_dir_mode,
            enabled: params.save_contig_annotations,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // BINNING PREPARATION
    // ========================================================================

    withName: BOWTIE2_ASSEMBLY_BUILD {
        ext.prefix = { "${meta.assembler}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Binning/mapping/bowtie2/index/${meta.assembler}" },
            mode: params.publish_dir_mode,
            pattern: "bowtie2/*",
            enabled: false
        ]
    }
    
    withName: BOWTIE2_ASSEMBLY_ALIGN {
        ext.prefix = { "${meta.assembler}-${meta.id}.${meta.reads_id}" }
        ext.args   = params.bowtie2_mode ?: ''
        ext.args2  = '--output-fmt bam'
        publishDir = [
            [
                path: { "${params.outdir}/Binning/mapping/bowtie2/log/${meta.assembler}/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.log"
            ]
        ]
    }
    
    withName: BWAMEM2_ASSEMBLY_INDEX {
        ext.prefix = { "${meta.assembler}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Binning/mapping/bwamem2/index/${meta.assembler}" },
            mode: params.publish_dir_mode,
            pattern: "bwamem2/*",
            enabled: false
        ]
    }
    
    withName: BWAMEM2_ASSEMBLY_MEM {
        ext.prefix = { "${meta.assembler}-${meta.id}.assembly" }
        ext.args   = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA'" }
        ext.args2  = '--output-fmt bam'
        publishDir = [
            path: { "${params.outdir}/Binning/mapping/bwamem2/bam/${meta.assembler}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.bam",
            enabled: false  // Raw BAM not needed, sorted version will be published
        ]
    }
    
    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.assembler}-${meta.id}.sorted" }
        publishDir = [
            path: { "${params.outdir}/Binning/mapping/sorted_bam/${meta.assembler}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.bam",
            enabled: params.save_assembly_mapped_reads
        ]
    }
    
    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/Binning/mapping/sorted_bam/${meta.assembler}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.bai",
            enabled: params.save_assembly_mapped_reads
        ]
    }

    // ========================================================================
    // BINNING TOOLS
    // ========================================================================

    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS {
        ext.prefix = { "${meta.assembler}-${meta.id}-depth" }
        publishDir = [
            path: { "${params.outdir}/Binning/depths/contigs" },
            mode: params.publish_dir_mode,
            pattern: '*-depth.txt.gz'
        ]
    }

    withName: METABAT2_METABAT2 {
        ext.prefix = { "${meta.assembler}-MetaBAT2-${meta.id}" }
        ext.args   = [
            params.min_contig_size < 1500 ? "-m 1500" : "-m ${params.min_contig_size}",
            "--unbinned",
            "--seed ${params.metabat_rng_seed}"
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.outdir}/Binning/MetaBAT2/bins/" },
                mode: params.publish_dir_mode,
                pattern: '*[!lowDepth|tooShort|unbinned].fa.gz'
            ],
            [
                path: { "${params.outdir}/Binning/MetaBAT2/discarded" },
                mode: params.publish_dir_mode,
                pattern: '*tooShort.fa.gz'
            ],
            [
                path: { "${params.outdir}/Binning/MetaBAT2/discarded" },
                mode: params.publish_dir_mode,
                pattern: '*lowDepth.fa.gz'
            ]
        ]
    }

    withName: MAXBIN2 {
        ext.prefix = { "${meta.assembler}-MaxBin2-${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/Binning/MaxBin2/discarded" },
                mode: params.publish_dir_mode,
                pattern: '*.tooshort.gz'
            ],
            [
                path: { "${params.outdir}/Binning/MaxBin2/" },
                mode: params.publish_dir_mode,
                pattern: '*.{summary,abundance}'
            ]
        ]
    }

    withName: ADJUST_MAXBIN2_EXT {
        publishDir = [
            path: { "${params.outdir}/Binning/MaxBin2/bins/" },
            mode: params.publish_dir_mode,
            pattern: '*.fa.gz'
        ]
    }

    withName: 'CONCOCT_CUTUPFASTA' {
        ext.args = '-c 10000 -o 0 --merge_last'  // Standard CONCOCT parameters for cutting contigs
        ext.prefix = { "${meta.assembler}-CONCOCT-${meta.id}" }
    }

    withName: 'CONCOCT_CONCOCTCOVERAGETABLE' {
        ext.prefix = { "${meta.assembler}-CONCOCT-${meta.id}" }
    }

    withName: 'CONCOCT_CONCOCT' {
        //ext.args = '--composition_file ${prefix}.fasta --coverage_file ${prefix}.tsv --length_threshold 1000'
        ext.prefix = { "${meta.assembler}-CONCOCT-${meta.id}" }
    }


    withName: 'CONCOCT_.*' {
        ext.prefix = { "${meta.assembler}-CONCOCT-${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/Binning/CONCOCT/stats/" },
                mode: params.publish_dir_mode,
                pattern: "*.{txt,csv,tsv}"
            ],
            [
                path: { "${params.outdir}/Binning/CONCOCT/bins" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> new File(filename).getName() },
                pattern: "*/*.fa.gz"
            ]
        ]
    }

    withName: COMEBIN_RUNCOMEBIN {
        ext.prefix = { "${meta.assembler}-COMEBin-${meta.id}" }
        ext.args = ""
        publishDir = [
            [
                path: { "${params.outdir}/Binning/COMEBin/stats" },
                mode: params.publish_dir_mode,
                pattern: "*/*.{log,tsv,csv}"
            ],
            [
                path: { "${params.outdir}/Binning/COMEBin/bins" },
                mode: params.publish_dir_mode,
                pattern: "*/comebin_res_bins/*.fa.gz"
            ]
        ]
    }

    withName: SEMIBIN_SINGLEEASYBIN {
        ext.prefix = { "${meta.assembler}-SemiBin2-${meta.id}" }
        ext.args = ''
        ext.args2 = "--environment ${params.semibin_environment}"
        publishDir = [
            [
                path: { "${params.outdir}/Binning/SemiBin2/stats" },
                mode: params.publish_dir_mode,
                pattern: "*/*.{csv,tsv,h5}"
            ],
            [
                path: { "${params.outdir}/Binning/SemiBin2/bins" },
                mode: params.publish_dir_mode,
                pattern: "*/output_bins/*.fa.gz"
            ]
        ]
    }

    withName: VAMB_BIN {
        ext.prefix = { "${meta.assembler}-VAMB-${meta.id}" }
        ext.args = '--minfasta 1' // Can add option "-m 1000" to adjust minimum contig size if needed
        publishDir = [
            [
                path: { "${params.outdir}/Binning/VAMB/stats" },
                mode: params.publish_dir_mode,
                pattern: "*/*.{tsv,txt}"
            ],
            [
                path: { "${params.outdir}/Binning/VAMB/bins" },
                mode: params.publish_dir_mode,
                pattern: "*/bins/*.fna.gz"
            ],
            [
                path: { "${params.outdir}/Binning/VAMB/trainedfiles" },
                mode: params.publish_dir_mode,
                pattern: "*/*.npz"
            ]
        ]
    }

    // ========================================================================
    // BINNING REFINEMENT
    // ========================================================================

    withName: DASTOOL_DASTOOL {
        ext.prefix = { "${meta.assembler}-DASTool-${meta.id}" }
        ext.args   = "--write_bins --write_unbinned --write_bin_evals --score_threshold ${params.refine_bins_dastool_threshold}"
        publishDir = [
            [
                path: { "${params.outdir}/Binning/DASTool/stats" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv,log,eval,seqlength}'
            ]
        ]
    }

    withName: BINETTE_BINETTE {
        publishDir = [
            [
                path: { "${params.outdir}/Binning/Binette/stats" },
                mode: params.publish_dir_mode,
                pattern: "*_final_bins_quality_reports.tsv"
            ],
            [
                path: { "${params.outdir}/Binning/Binette/logs" },
                mode: params.publish_dir_mode,
                pattern: "*.{log,yml}"
            ],
            [
                path: { "${params.outdir}/Binning/Binette/stats" },
                mode: params.publish_dir_mode,
                pattern: "*_input_bins_quality_reports/*.tsv"
            ]
        ]
        ext.prefix = { "${meta.assembler}-Binette-${meta.id}" }
        ext.args   = "--min_completeness ${params.refine_bins_binette_min_completeness} --contamination_weight ${params.refine_bins_binette_contamination_weight}"
    }

    withName: RENAME_PREBINREFINE {
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: RENAME_POSTBINREFINE {
        publishDir = [
            [
                path: { "${params.outdir}/Binning/${meta.binrefine}/bins" },
                mode: params.publish_dir_mode,
                pattern: '*-*Refined-*.fa',
            ],
            [
                path: { "${params.outdir}/Binning/${meta.binrefine}/unbinned" },
                mode: params.publish_dir_mode,
                pattern: '*-*Unbinned-*.fa',
            ],
            [
                path: { "${params.outdir}/Binning/${meta.binrefine}/stats" },
                mode: params.publish_dir_mode,
                pattern: '*.tsv'
            ],
            [
                path: { "${params.outdir}/Binning/${meta.binrefine}/logs" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    // ========================================================================
    // BINNING UTILITIES
    // ========================================================================

    withName: SPLIT_FASTA {
        publishDir = [
            [
                path: { "${params.outdir}/Binning/${meta.binner}/unbinned" },
                mode: params.publish_dir_mode,
                pattern: '*.*[0-9].fa.gz'
            ],
            [
                path: { "${params.outdir}/Binning/${meta.binner}/unbinned/discarded" },
                mode: params.publish_dir_mode,
                pattern: '*.pooled.fa.gz'
            ],
            [
                path: { "${params.outdir}/Binning/${meta.binner}/unbinned/discarded" },
                mode: params.publish_dir_mode,
                pattern: '*.remaining.fa.gz'
            ]
        ]
    }

    withName: CONVERT_DEPTHS {
        publishDir = [
            enabled: false
        ]
    }

    withName: FASTATOCONTIG2BIN_METABAT2 {
        ext.prefix = { "${meta.assembler}-MetaBAT2-${meta.id}" }
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: FASTATOCONTIG2BIN_MAXBIN2 {
        ext.prefix = { "${meta.assembler}-MaxBin2-${meta.id}" }
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: FASTATOCONTIG2BIN_CONCOCT {
        ext.prefix = { "${meta.assembler}-CONCOCT-${meta.id}" }
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: FASTATOCONTIG2BIN_VAMB {
        ext.prefix = { "${meta.assembler}-VAMB-${meta.id}" }
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: FASTATOCONTIG2BIN_COMEBIN {
        ext.prefix = { "${meta.assembler}-COMEBin-${meta.id}" }
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: FASTATOCONTIG2BIN_SEMIBIN {
        ext.prefix = { "${meta.assembler}-SemiBin2-${meta.id}" }
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: GUNZIP {
        publishDir = [
            enabled: false
        ]
    }

    // ========================================================================
    // BIN QUALITY CONTROL
    // ========================================================================

    withName: 'QUAST_BINS' {
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        //ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Binning/QC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'QUAST_BINS_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/Binning/QC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'ASSEMBLY_STATS' {
        errorStrategy = 'ignore'
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [path: {"${params.outdir}/Binning/QC/AssemblyStats"}, pattern: "*.csv", mode: 'copy']
        ext.args = { params.assembly_stats_params ?: '' }
    }

    withName: BUSCO_UNTAR {
        ext.basedir = 'busco_db/lineages'
    }

    withName: BUSCO_BUSCO {
        tag = { "${fasta.baseName}" }
        ext.args = [
            params.busco_db ? '--offline' : ''
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.outdir}/Binning/QC/BUSCO/${meta.id}/${fasta.baseName}" },
                mode: params.publish_dir_mode,
                pattern: "*{.txt,.json,.log,-busco}",
            ],
            [
                path: { "${params.outdir}/Databases/BUSCO" },
                mode: params.publish_dir_mode,
                overwrite: false,
                pattern: "busco_downloads/lineages/*",
                enabled: params.save_busco_db,
            ]
        ]
    }

    withName: CHECKM_UNTAR {
        publishDir = [
            path: { "${params.outdir}/Databases/CheckM" },
            mode: params.publish_dir_mode,
            overwrite: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_checkm_data,
        ]
    }

    withName: CHECKM_LINEAGEWF {
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}_lineagewf" }
        ext.args = '--reduced_tree'
        publishDir = [
            path: { "${params.outdir}/Binning/QC/CheckM" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: CHECKM_QA {
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}_qa" }
        ext.args = "-o 2 --tab_table"
        publishDir = [
            path: { "${params.outdir}/Binning/QC/CheckM" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: CHECKM2_DATABASEDOWNLOAD {
        publishDir = [
            path: { "${params.outdir}/Databases/CheckM2" },
            mode: params.publish_dir_mode,
            overwrite: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_checkm2_data,
        ]
    }

    withName: CHECKM2_PREDICT {
        //tag = { "${meta.assembler}-${meta.binner}-${meta.id}" }
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.args = '--force'
        publishDir = [
            path: { "${params.outdir}/Binning/QC/CheckM2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: CONCAT_BINQC_TSV {
        ext.prefix = { "${params.binqc_tool}_summary" }
        publishDir = [
            path: { "${params.outdir}/Binning/QC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*{.txt,.tsv,.csv}",
        ]
    }

    withName: GUNC_DOWNLOADDB {
        publishDir = [
            path: { "${params.outdir}/Databases/GUNC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.gunc_save_db,
        ]
    }

    withName: GUNC_RUN {
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.args = '--detailed_output'
        publishDir = [
            path: { "${params.outdir}/Binning/QC/GUNC/raw/${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: GUNC_MERGECHECKM {
        tag = { "${meta.assembler}-${meta.binner}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Binning/QC/GUNC/checkmmerged/${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}/${checkm_file.baseName}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // ========================================================================
    // BIN DOMAIN CLASSIFICATION
    // ========================================================================

    withName: DASTOOL_FASTATOCONTIG2BIN_TIARA {
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            enabled: false  // Intermediate file
        ]
    }

    withName: TIARA_CLASSIFY {
        ext.args   = { "--join_prokaryotes --assembler ${meta.assembler}" }
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            enabled: false
        ]
    }

    withName: TIARA_SUMMARY {
        tag = "tiara_summary"
        ext.prefix = "tiara_summary"
        publishDir = [
            path: { "${params.outdir}/Binning/Tiara" },
            mode: params.publish_dir_mode,
            pattern: "tiara_summary.tsv"
        ]
    }

    // ========================================================================
    // BIN ANNOTATION
    // ========================================================================

    withName: BAKTA_BAKTADBDOWNLOAD {
        publishDir = [
            path: { "${params.outdir}/Databases/Bakta" },
            mode: params.publish_dir_mode,
            enabled: params.save_bakta_db,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "--type ${params.annotation_bakta_db_downloadtype}"
    }

    withName: BAKTA_BINS {
        ext.prefix = { "${meta.bin_id}.bakta" }
        publishDir = [
            path: { "${params.outdir}/Binning/Annotation/Bakta/${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}/${meta.bin_id}" },
            mode: params.publish_dir_mode,
            enabled: params.save_bin_annotations,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = [
            params.annotation_bakta_singlemode ? '' : '--meta',
            "--min-contig-length ${params.annotation_bakta_mincontiglen}",
            "--translation-table ${params.annotation_bakta_translationtable}",
            "--gram ${params.annotation_bakta_gram}",
            params.annotation_bakta_complete ? '--complete' : '',
            params.annotation_bakta_renamecontigheaders ? '' : '--keep-contig-headers',
            params.annotation_bakta_compliant ? '--compliant' : '',
            params.annotation_bakta_trna ? '' : '--skip-trna',
            params.annotation_bakta_tmrna ? '' : '--skip-tmrna',
            params.annotation_bakta_rrna ? '' : '--skip-rrna',
            params.annotation_bakta_ncrna ? '' : '--skip-ncrna',
            params.annotation_bakta_ncrnaregion ? '' : '--skip-ncrna-region',
            params.annotation_bakta_crispr ? '' : '--skip-crispr',
            params.annotation_bakta_skipcds ? '--skip-cds' : '',
            params.annotation_bakta_pseudo ? '' : '--skip-pseudo',
            params.annotation_bakta_skipsorf ? '--skip-sorf' : '',
            params.annotation_bakta_gap ? '' : '--skip-gap',
            params.annotation_bakta_ori ? '' : '--skip-ori',
            params.annotation_bakta_activate_plot ? '' : '--skip-plot',
            params.annotation_bakta_hmms ? "--hmms ${params.annotation_bakta_hmms}" : ''
        ].join(' ').trim()
    }

    withName: PROKKA_BINS {
        ext.prefix = { "${meta.bin_id}.prokka" }
        ext.args = [
            '--metagenome',
            params.prokka_bins_fast_mode ? '--fast' : '',
            params.prokka_bins_with_compliance ? "--compliant --centre ${params.prokka_bins_compliance_centre}" : ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/Binning/Annotation/Prokka/${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}" },
            mode: params.publish_dir_mode,
            enabled: params.save_bin_annotations,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // BIN TAXONOMIC CLASSIFICATION
    // ========================================================================

    withName: CREATE_BINS_CSV {
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.args = ""
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Taxonomy/sourmash/bins_csv" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }
    
    withName: SOURMASH_MANYSKETCH_BINS {
        tag = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        ext.args_sourmash = ""
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Taxonomy/sourmash/sketches" },
            mode: params.publish_dir_mode,
            enabled: params.enable_copysketch
        ]
    }

    withName: EXTRACT_SOURMASH_SINGLESKETCHES {
        ext.args_python = ""
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/Taxonomy/sourmash/sketches/single_sketches/${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}" },
                mode: params.publish_dir_mode,
                enabled: params.enable_copysketch_singles
            ],
            [
                path: { "${params.outdir}/Taxonomy/sourmash/sketches/single_sketches" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml"
            ]
        ]
    }
    
    withName: SOURMASH_FASTMULTIGATHER_BINS {
        //ext.ksize = { params.sourmash_ksize_bins }
        ext.args = [
            params.sourmash_thresholdbp ? "--threshold-bp=${params.sourmash_thresholdbp}" : '--threshold-bp=50000'
        ].join(' ').trim()
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/Taxonomy/sourmash/fastmultigather" },
                mode: params.publish_dir_mode,
                pattern: "fastmultigather/*_sourmash_gather.csv"
            ],
            [
                path: { "${params.outdir}/Taxonomy/sourmash/fastmultigather/logs" },
                mode: params.publish_dir_mode,
                pattern: "fastmultigather/*.{log,txt}"
            ]
        ]
    }

    withName: SOURMASH_TAXANNOTATE {
        ext.args = ""
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}_sourmash_gather" }
        publishDir = [
            path: { "${params.outdir}/Taxonomy/sourmash/taxannotate" },
            mode: params.publish_dir_mode,
            pattern: "*.with-lineages.csv.gz",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: SOURMASH_TAXGENOME {
        ext.args = [
            "--output-format ${params.sourmash_output_format}"
        ].join(' ').trim()
        ext.prefix = { "${meta.assembler}-${meta.binner ?: 'binrefine'}-${meta.binrefine ?: 'rawbins'}-${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Taxonomy/sourmash" },
            mode: params.publish_dir_mode,
            pattern: "taxgenome/*.csv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'COMBINE_FASTMULTIGATHER_RESULTS|COMBINE_TAXANNOTATE_RESULTS|COMBINE_TAXGENOME_RESULTS' {
        ext.args = ""
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/Taxonomy/sourmash/summary" },
            mode: params.publish_dir_mode,
            pattern: "*.csv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // BACTERIAL GENOME INPUT AND ROUTING
    // ========================================================================

    withName: 'VALIDATE_GENOME_INPUT|NORMALIZE_GENOME_CLASSIFICATIONS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: PUBLISH_GENOME_ROUTING {
        publishDir = [
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/routing" },
                mode: params.publish_dir_mode,
                pattern: "*.tsv"
            ],
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/versions" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml",
                saveAs: { "genome_routing.versions.yml" }
            ]
        ]
    }

    // ========================================================================
    // BACTERIAL AMR ANALYSIS
    // ========================================================================

    withName: VALIDATE_BACTERIAL_AMR_DATABASES {
        publishDir = [
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/database_validation" },
                mode: params.publish_dir_mode,
                pattern: "amr_database_validation.tsv"
            ],
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/versions" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml",
                saveAs: { "amr_database_validation.versions.yml" }
            ]
        ]
    }

    withName: STAGE_RGI_DATABASE_ALIASES {
        publishDir = [enabled: false]
    }

    withName: PYRODIGAL_AMR {
        ext.prefix = { "${meta.genome_id}.deeparg_orfs" }
        ext.args = [
            '-p single',
            '--no-stop-codon',
            "-g ${params.annotation_pyrodigal_transtable}"
        ].join(' ').trim()
        publishDir = [enabled: false]
    }

    withName: GUNZIP_DEEPARG_ORFS {
        publishDir = [enabled: false]
    }

    withName: AMRFINDERPLUS_AMR {
        ext.prefix = { "${meta.genome_id}.amrfinderplus" }
        ext.args = { params.amrfinderplus_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/amrfinderplus" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: WRITE_SKIPPED_AMRFINDERPLUS {
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/skipped" },
            mode: params.publish_dir_mode,
            pattern: "*.skipped.*"
        ]
    }

    withName: ABRICATE_AMR {
        ext.prefix = { "${meta.genome_id}.abricate" }
        ext.args = [
            "--db ${params.abricate_db_id}",
            params.abricate_args ?: ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/abricate" },
            mode: params.publish_dir_mode,
            pattern: "*.txt"
        ]
    }

    withName: RGI_AMR {
        ext.prefix = { "${meta.genome_id}.rgi" }
        ext.args = { params.rgi_load_args ?: '' }
        ext.args2 = {
            [
                '--input_type contig --clean',
                params.rgi_main_args ?: ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/rgi" },
            mode: params.publish_dir_mode,
            pattern: "*.{txt,json}"
        ]
    }

    withName: WRITE_SKIPPED_RGI {
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/skipped" },
            mode: params.publish_dir_mode,
            pattern: "*.skipped.*"
        ]
    }

    withName: RESFINDER_AMR {
        ext.args = {
            [
                '-acq',
                meta.pointfinder_species
                    ? "-c -s \"${meta.pointfinder_species}\""
                    : '',
                params.resfinder_args ?: ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/resfinder_pointfinder" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: WRITE_SKIPPED_RESFINDER {
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/skipped" },
            mode: params.publish_dir_mode,
            pattern: "*.skipped.*"
        ]
    }

    withName: DEEPARG_AMR {
        ext.prefix = { "${meta.genome_id}.deeparg" }
        ext.args = { params.deeparg_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/deeparg" },
            mode: params.publish_dir_mode
        ]
    }

    withName: HAMRONIZATION_AMRFINDERPLUS_AMR {
        ext.prefix = { "${meta.genome_id}.amrfinderplus.hamronized" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/harmonized/amrfinderplus" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: HAMRONIZATION_ABRICATE_AMR {
        ext.prefix = { "${meta.genome_id}.abricate.hamronized" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/harmonized/abricate" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: HAMRONIZATION_RGI_AMR {
        ext.prefix = { "${meta.genome_id}.rgi.hamronized" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/harmonized/rgi" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: HAMRONIZATION_DEEPARG_AMR {
        ext.prefix = { "${meta.amr_result_id}.hamronized" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/harmonized/deeparg" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: ARGNORM_AMRFINDERPLUS_AMR {
        ext.prefix = { "${meta.genome_id}.amrfinderplus.argnorm.tsv" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/normalized/amrfinderplus" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: ARGNORM_ABRICATE_AMR {
        ext.prefix = { "${meta.genome_id}.abricate.argnorm.tsv" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/normalized/abricate" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: ARGNORM_DEEPARG_AMR {
        ext.prefix = { "${meta.amr_result_id}.argnorm.tsv" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/normalized/deeparg" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: HAMRONIZATION_SUMMARIZE_AMR {
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/harmonized_summary" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: WRITE_AMR_SAMPLE_MANIFEST {
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/amr/${meta.source_route}/${meta.sample_id}/${meta.genome_id}" },
            mode: params.publish_dir_mode,
            pattern: "*.amr_manifest.tsv"
        ]
    }

    // ========================================================================
    // BACTERIAL GENERAL TYPING (playground/modular/2_general_bac.sh)
    // ========================================================================

    withName: 'GUNZIP_GENERAL_TYPING|VIRULENCEFINDER_DOWNLOADDB_LOCAL' {
        publishDir = [enabled: false]
    }

    withName: VIRULENCEFINDER_TYPING {
        ext.prefix = { "${meta.genome_id}.virulencefinder" }
        ext.args = [
            "-l ${params.virulencefinder_min_coverage ?: 0.6}",
            "-t ${params.virulencefinder_min_identity ?: 0.9}",
            params.virulencefinder_args ?: ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/general_typing/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/virulencefinder" },
            mode: params.publish_dir_mode,
            pattern: "*.{json,tsv,txt,fsa}",
            // 2_general_bac.sh keeps data.json as <genome>.virulencefinder.json
            saveAs: { filename -> filename.endsWith('.legacy.json') ? "${meta.genome_id}.virulencefinder.json" : filename }
        ]
    }

    withName: PLASMIDFINDER_TYPING {
        ext.prefix = { "${meta.genome_id}.plasmidfinder" }
        ext.args = { params.plasmidfinder_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/general_typing/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/plasmidfinder" },
            mode: params.publish_dir_mode,
            pattern: "*.{json,txt,tsv,fsa}"
        ]
    }

    withName: MLST_TYPING {
        ext.prefix = { "${meta.genome_id}.mlst" }
        ext.args = { ['--full', params.mlst_args ?: ''].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/general_typing/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/mlst" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    // ========================================================================
    // GENUS-SPECIFIC BACTERIAL TYPING
    // ========================================================================

    withName: KLEBORATE_TYPING {
        ext.prefix = { "${meta.genome_id}.kleborate" }
        ext.args = { params.kleborate_args ?: '' }
        publishDir = [
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/klebsiella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/kleborate" },
                mode: params.publish_dir_mode,
                pattern: "*.txt"
            ],
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/klebsiella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/summary" },
                mode: params.publish_dir_mode,
                pattern: "*.txt",
                saveAs: { "${meta.genome_id}.klebsiella_typing_summary.tsv" }
            ]
        ]
    }

    withName: GUNZIP_SALMONELLA_TYPING {
        publishDir = [enabled: false]
    }

    withName: SEQSERO2_SALMONELLA {
        ext.prefix = { "${meta.genome_id}" }
        ext.args = [
            '-m k -t 4',
            params.seqsero2_args ?: ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/salmonella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/seqsero2" },
            mode: params.publish_dir_mode,
            pattern: "results/*",
            // 4_sal.sh names: <genome>.seqsero2_{log.txt,result.tsv,result.txt}
            saveAs: { filename ->
                def name = filename.tokenize('/')[-1]
                name.endsWith('_log.txt') ? "${meta.genome_id}.seqsero2_log.txt" :
                name.endsWith('_result.tsv') ? "${meta.genome_id}.seqsero2_result.tsv" :
                name.endsWith('_result.txt') ? "${meta.genome_id}.seqsero2_result.txt" : null
            }
        ]
    }

    withName: SISTR_SALMONELLA {
        ext.prefix = { "${meta.genome_id}" }
        ext.args = { params.sistr_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/salmonella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/raw/sistr" },
            mode: params.publish_dir_mode,
            pattern: "*.{tab,fasta,json,csv}"
        ]
    }

    withName: MYKROBE_SALMONELLA {
        ext.prefix = { "${meta.genome_id}.mykrobe" }
        // 4_sal.sh adds --ncbi_names (mykrobe >=0.12); the pinned 0.11 lacks it and it only renames species.
        ext.args = { params.mykrobe_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/salmonella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/follow_up/genotyphi" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: PARSE_SALMONELLA_TYPING {
        publishDir = [
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/salmonella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/routing" },
                mode: params.publish_dir_mode,
                pattern: "*.salmonella_{evidence,routing}.tsv"
            ],
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/salmonella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/summary" },
                mode: params.publish_dir_mode,
                pattern: "*.salmonella_evidence.tsv",
                saveAs: { "${meta.genome_id}.salmonella_typing_summary.tsv" }
            ],
            [
                path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/versions" },
                mode: params.publish_dir_mode,
                pattern: "versions.yml",
                saveAs: { "${meta.sample_id}.${meta.genome_id}.salmonella_routing.versions.yml" }
            ]
        ]
    }

    withName: GENOTYPHI_SALMONELLA {
        ext.prefix = { "${meta.genome_id}.genotype" }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/salmonella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/follow_up/genotyphi" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: 'VALIDATE_PARATYPE_BUNDLE|PARATYPE_DOWNLOAD_LOCAL' {
        publishDir = [enabled: false]
    }

    withName: PARATYPE_RUN {
        ext.prefix = { "${meta.genome_id}" }
        ext.args = { params.paratype_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/Assembly/Downstream_Bacterial_Analysis/salmonella/${meta.source_route}/${meta.sample_id}/${meta.genome_id}/follow_up/paratype" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }
}
